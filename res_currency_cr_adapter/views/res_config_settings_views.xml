<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_crc_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.crc.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='main_currency_setting_container']" position="after">
                <setting id="main_currency_l10n_cr" string="Costa Rica Currency Adapter" help="Update the dollar exchange rate from Ministerio de Hacienda or BCCR">
                    <field name="exchange_source" string="Exchange rate origin"/>
                    <field name="bccr_username" string="User name registered in the BCCR" required="exchange_source == 'bccr'" invisible="exchange_source != 'bccr'"/>
                    <field name="bccr_email" string="email registered in the BCCR" required="exchange_source == 'bccr'" invisible="exchange_source != 'bccr'"/>
                    <field name="bccr_token" string="BCCR Token" password="True" required="exchange_source == 'bccr'" invisible="exchange_source != 'bccr'"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
